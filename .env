# Database Configuration
# PostgreSQL with pgvector for production / Docker, or SQLite for zero-dependency local testing
# Using SQLite for local testing without external database
DATABASE_URL=sqlite:///./truthgraph_dev.db

# Authentication Security
JWT_SECRET_KEY=change-this-in-production-use-a-strong-32-byte-hex-or-base64-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI LLM Provider: 'mock' (deterministic offline/test mode), 'gemini', 'openai', 'anthropic', 'ollama'
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-model

# Embedding Provider: 'mock' (deterministic 384-dim hash embeddings), 'gemini', 'openai', 'huggingface'
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-embed-v1

# Document Upload Limits & Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
